{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stillwater-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "WalletAutomation" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WalletAutomation"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stillwater-prod",
      "database_id": "156f0e29-c4e7-466e-a04a-43942435f3b5",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../api/migrations",
    },
  ],
  "services": [
    {
      "binding": "API",
      "service": "stillwater-api",
    },
  ],
  "observability": { "enabled": true },
}
